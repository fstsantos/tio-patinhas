# Copie para .env e preencha. Nunca versione o .env.
AMBIENTE=desenvolvimento            # desenvolvimento | teste | producao
DATABASE_URL=postgresql+psycopg://financas:troque-me@localhost:5432/financas
POSTGRES_PASSWORD=troque-me         # usada pelo compose.yaml
LOG_LEVEL=INFO
LOG_JSON=true

# Telegram (BotFather). Desative o privacy mode antes de adicionar ao grupo.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# chat_id do grupo da família (negativo), separados por vírgula
TELEGRAM_CHATS_PERMITIDOS=
# Preencha apenas na nuvem para usar webhook em vez de polling
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_PORTA=8443

# Web
WEB_SECRET_KEY=gere-com-python-c-import-secrets-print-secrets-token_urlsafe-48
WEB_SESSAO_HORAS=12
WEB_HOST=0.0.0.0
WEB_PORT=8000

# Voz: faster_whisper (padrão, local) | openai | falso
STT_PROVEDOR=faster_whisper
STT_MODELO_WHISPER=small             # tiny | base | small | medium (mais RAM, mais precisão)
STT_MODELO_OPENAI=gpt-4o-mini-transcribe
STT_TIMEOUT_SEGUNDOS=120
VOZ_DURACAO_MAXIMA_SEGUNDOS=120
OPENAI_API_KEY=

# LLM opcional: só é chamada quando a interpretação local do áudio falha (ou quando o
# áudio parece ter mais de um lançamento). Ela só propõe; você confirma no botão.
#   nenhum    -> desligada
#   anthropic -> Claude. LLM_MODELO vazio = claude-haiku-5-5.
#   openai    -> OpenAI ou qualquer serviço compatível com "chat completions".
#                LLM_MODELO é obrigatório; LLM_BASE_URL vazio = https://api.openai.com/v1
#                (ex. de modelo local: LLM_BASE_URL=http://host.docker.internal:11434/v1).
# Para trocar de provedor, mude só estas linhas. Teste com: financas testar-llm "frase".
LLM_PROVEDOR=nenhum
LLM_MODELO=
LLM_BASE_URL=
LLM_API_KEY=
LLM_TIMEOUT_SEGUNDOS=15
# Alternativas a LLM_API_KEY, usadas se ela estiver vazia:
ANTHROPIC_API_KEY=

# Backup (scripts/backup.sh)
BACKUP_DIR=./backups
BACKUP_RETENCAO_DIAS=30
